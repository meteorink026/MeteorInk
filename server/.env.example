# MeteorInk production environment
# NEVER commit a real .env file or secrets.

GOOGLE_CLIENT_ID=PASTE_YOUR_METEORINK_WEB_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=PASTE_YOUR_METEORINK_WEB_CLIENT_SECRET_HERE
GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN/auth/google/callback
SESSION_SECRET=GENERATE_A_LONG_RANDOM_SECRET
PORT=3000
NODE_ENV=production

# Supabase server-side connection
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=PASTE_YOUR_SUPABASE_SECRET_KEY_HERE
