# Copy this file to .env and fill in the values.
# Never publish .env or your Google client secret.

GOOGLE_CLIENT_ID=PASTE_YOUR_METEORINK_WEB_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=PASTE_YOUR_METEORINK_WEB_CLIENT_SECRET_HERE
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
SESSION_SECRET=replace-with-a-long-random-secret
PORT=3000
